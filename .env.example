# Application Configuration
APP_NAME="Regent HR Management API"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (Default to local SQLite for local dev/testing)
# For SQLite local dev: sqlite:///./hr_management.db
# For PostgreSQL Docker Compose: postgresql://hr_user:hr_password@db:5432/hr_db
DATABASE_URL="sqlite:///./hr_management.db"

# Security & Authentication
# Note: Use a strong, random 256-bit secret key in production (e.g. generated via `openssl rand -hex 32`)
SECRET_KEY="academic-demonstration-secret-key-change-in-production-environments"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Credentials (used by scripts/create_admin.py)
FIRST_SUPERADMIN_EMAIL="admin@regent.ac.uk"
FIRST_SUPERADMIN_PASSWORD="AdminPassword123!"
FIRST_SUPERADMIN_FULL_NAME="System Administrator"

# CORS Configuration (Comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000"
